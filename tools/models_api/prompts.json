      },
      {
        "id": "analysis_style",
        "label": "解析风格",
        "type": "radio_group",
        "options": [
          "心理学分析",
          "传统玄学",
          "混合模式"
        ],
        "defaultValue": "混合模式"
      }
    ]
  },
  {
    "id": "fitness_planner",
    "icon": "activity",
    "name": "健身计划制定",
    "description": "量身定制的周健身计划",
    "systemPrompt": "你是一个专业健身教练。请根据用户的身体状况和目标，制定一周的训练计划。包含饮食建议。",
    "inputs": [
