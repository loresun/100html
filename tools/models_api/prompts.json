[
  {
    "id": "xhs_copy",
    "icon": "instagram",
    "name": "小红书爆款文案",
    "description": "生成吸引人的小红书风格文案，包含Emoji和Tag",
    "systemPrompt": "你是一个小红书爆款文案专家。请根据用户的主题和语气，写一篇吸引人的文案。要求：\n1. 标题吸引人，包含关键词\n2. 正文分段，使用Emoji美化\n3. 语气自然亲切\n4. 结尾包含相关的Tag\n5. 字数控制在200-300字左右",
    "inputs": [
      {
        "id": "topic",
        "label": "内容主题",
        "type": "text",
        "placeholder": "例如：夏日防晒攻略",
        "required": true
      },
      {
        "id": "tone",
        "label": "文案语气",
        "type": "select",
        "options": [
          "亲切活泼",
          "专业干货",
          "情感共鸣",
          "幽默搞怪"
        ],
        "defaultValue": "亲切活泼"
      },
      {
        "id": "keywords",
        "label": "必须包含的关键词",
        "type": "text",
        "placeholder": "例如：敏感肌, 不假白"
      }
    ]
  },
  {
    "id": "translator",
    "icon": "languages",
    "name": "多语言翻译",
    "description": "精准的自然语言翻译助手",
    "systemPrompt": "你是一个精通多国语言的专业翻译官。请将用户输入的文本翻译成目标语言。要求信达雅，符合目标语言的表达习惯。",
    "inputs": [
      {
        "id": "text",
        "label": "待翻译文本",
        "type": "textarea",
        "placeholder": "请输入需要翻译的内容...",
        "required": true
      },
      {
        "id": "target_lang",
        "label": "目标语言",
        "type": "select",
        "options": [
          "英语",
          "日语",
          "韩语",
          "法语",
          "德语",
          "西班牙语",
          "中文"
        ],
        "defaultValue": "英语"
      }
    ]
  },
  {
    "id": "code_explainer",
    "icon": "code",
    "name": "代码解释器",
    "description": "解释复杂的代码片段",
    "systemPrompt": "你是一个资深程序员。请详细解释用户提供的代码片段。说明代码的功能、逻辑流程以及可能的注意事项。",
    "inputs": [
      {
        "id": "code",
        "label": "代码片段",
        "type": "textarea",
        "placeholder": "粘贴代码...",
        "required": true
      },
      {
        "id": "detail_level",
        "label": "解释详细度",
        "type": "range",
        "min": 1,
        "max": 5,
        "step": 1,
        "defaultValue": 3,
        "helpText": "1=简单, 5=极度详细"
      }
    ]
  },
  {
    "id": "weekly_report",
    "icon": "file-text",
    "name": "周报生成器",
    "description": "根据工作点生成结构化周报",
    "systemPrompt": "你是一个职场助手，擅长撰写专业的工作周报。请根据用户输入的工作要点，整理成一份格式清晰、重点突出的周报。",
    "inputs": [
      {
        "id": "completed",
        "label": "本周完成的工作",
        "type": "textarea",
        "placeholder": "简要列出已完成事项...",
        "required": true
      },
      {
        "id": "emotion",
        "label": "情绪状态 (影响行文语气)",
        "type": "range",
        "min": 0,
        "max": 100,
        "defaultValue": 80,
        "helpText": "0=低落, 100=充满激情"
      }
    ]
  },
  {
    "id": "prompt_optimizer",
    "icon": "sparkles",
    "name": "结构化提示词优化",
    "description": "将简单需求优化为结构化Prompt",
    "systemPrompt": "你是一个Prompt Engineering专家。请将用户输入的简单需求，优化为结构清晰、包含Context/Goal/Steps/Format的专业Prompt。",
    "inputs": [
      {
        "id": "raw_prompt",
        "label": "原始需求",
        "type": "textarea",
        "placeholder": "例如：帮我写个请假条",
        "required": true
      },
      {
        "id": "optimization_goals",
        "label": "优化侧重点 (多选)",
        "type": "checkbox_group",
        "options": [
          "增加角色设定",
          "明确输出格式",
          "添加思维链(CoT)",
          "增加通过限制条件"
        ],
        "defaultValue": [
          "增加角色设定",
          "明确输出格式"
        ]
      }
    ]
  },
  {
    "id": "image_prompt_gen",
    "icon": "image",
    "name": "AI绘画提示词生成",
    "description": "生成Midjourney/Stable Diffusion提示词",
    "systemPrompt": "你是一个AI绘画提示词生成专家。请根据用户的描述，生成包含主体、环境、风格、光照、视角等细节的英文提示词。",
    "inputs": [
      {
        "id": "subject",
        "label": "画面主体",
        "type": "text",
        "placeholder": "例如：赛博朋克风格的猫",
        "required": true
      },
      {
        "id": "aspect_ratio",
        "label": "图片比例",
        "type": "radio_group",
        "options": [
          "1:1 (正方形)",
          "16:9 (宽屏)",
          "9:16 (竖屏)",
          "4:3 (标准)"
        ],
        "defaultValue": "16:9 (宽屏)"
      },
      {
        "id": "style_strength",
        "label": "风格化程度",
        "type": "range",
        "min": 1,
        "max": 1000,
        "step": 50,
        "defaultValue": 750,
        "helpText": "Midjourney Stylize (0-1000)"
      }
    ]
  },
  {
    "id": "email_helper",
    "icon": "mail",
    "name": "商务邮件助手",
    "description": "撰写得体的商务邮件",
    "systemPrompt": "你是一个商务沟通专家。请帮助用户撰写或回复邮件，确保语气得体、目的明确。",
    "inputs": [
      {
        "id": "intent",
        "label": "邮件目的",
        "type": "text",
        "placeholder": "例如：拒绝客户的降价要求",
        "required": true
      },
      {
        "id": "tone_slider",
        "label": "语气正式度",
        "type": "range",
        "min": 1,
        "max": 5,
        "step": 1,
        "defaultValue": 4,
        "helpText": "1=随意, 5=极其正式"
      },
      {
        "id": "includes",
        "label": "包含元素 (多选)",
        "type": "checkbox_group",
        "options": [
          "问候语",
          "感谢致辞",
          "行动呼吁(CTA)",
          "签名档"
        ],
        "defaultValue": [
          "问候语",
          "感谢致辞"
        ]
      }
    ]
  },
  {
    "id": "dream_analysis",
    "icon": "moon",
    "name": "周公解梦",
    "description": "基于心理学和传统文化的梦境解析",
    "systemPrompt": "你是一个结合了现代心理学和传统周公解梦的分析师。请根据用户的梦境描述，提供温暖、积极且有洞察力的分析。",
